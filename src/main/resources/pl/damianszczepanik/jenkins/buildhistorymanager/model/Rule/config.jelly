<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">

    <f:section title="Rule">
        <f:repeatableHeteroProperty field="conditions" hasHeader="true" addCaption="Add Condition"/>

        <f:repeatableHeteroProperty field="actions" hasHeader="true" addCaption="Add Action"/>

        <f:entry field="matchAtMost" title="Process this rule at most (times)">
            <f:number default="-1"/>
        </f:entry>
        <f:entry field="continueAfterMatch" title="Proceed to the next rule if the conditions of this rule are met">
            <f:checkbox default="true"/>
        </f:entry>

        <div align="right">
            <f:repeatableDeleteButton/>
        </div>
    </f:section>

</j:jelly>
